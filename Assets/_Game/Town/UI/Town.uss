.town {
    flex-grow: 1;
    flex-direction: row;
    font-size: 16px;
    color: rgb(236, 232, 240);
}

.main {
    flex-grow: 1;
    padding: 18px;
}

.spacer {
    flex-grow: 1;
}

.topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.clock,
.place,
.coins {
    background-color: rgba(24, 22, 32, 0.85);
    border-radius: 10px;
    padding: 8px 14px;
    margin-right: 8px;
    -unity-font-style: bold;
}

.place {
    color: rgb(255, 196, 214);
}

.coins {
    color: rgb(255, 214, 120);
}

.garment {
    flex-direction: row;
    align-items: center;
}

.swatch {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
}

.known.life {
    color: rgb(170, 214, 255);
    margin-bottom: 6px;
}

.known.style {
    color: rgb(200, 180, 255);
    margin-bottom: 6px;
}

.notice {
    align-self: flex-start;
    margin-top: 10px;
    padding: 6px 12px;
    border-radius: 8px;
    background-color: rgba(60, 48, 24, 0.9);
    color: rgb(255, 224, 160);
    white-space: normal;
}

.dialogue {
    flex-shrink: 0;
    max-width: 900px;
    padding: 16px 20px;
    background-color: rgba(24, 22, 32, 0.92);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.speaker {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 160, 196);
    margin-bottom: 4px;
}

.line {
    font-size: 21px;
    white-space: normal;
}

.follow-up {
    margin-top: 6px;
    color: rgb(220, 214, 236);
}

.deltas {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.delta {
    font-size: 13px;
    padding: 3px 9px;
    margin-right: 6px;
    border-radius: 10px;
    background-color: rgb(54, 50, 68);
}

.delta.up {
    color: rgb(150, 230, 170);
}

.delta.down {
    color: rgb(255, 150, 150);
}

.delta.stage {
    background-color: rgb(216, 98, 142);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.learnt {
    margin-top: 8px;
    color: rgb(255, 214, 120);
    -unity-font-style: italic;
}

.panel {
    width: 470px;
    margin: 18px 18px 18px 0;
    padding: 14px 16px;
    background-color: rgba(24, 22, 32, 0.9);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.section {
    font-size: 13px;
    color: rgb(170, 164, 184);
    -unity-font-style: bold;
    margin: 6px 0 6px 2px;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
}

Button {
    margin: 2px 6px 4px 0;
    padding: 5px 12px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgb(54, 50, 68);
    color: rgb(236, 232, 240);
}

Button:hover {
    background-color: rgb(72, 66, 92);
}

Button:disabled {
    opacity: 0.35;
}

Button.selected,
.primary {
    background-color: rgb(216, 98, 142);
    -unity-font-style: bold;
}

.chip {
    font-size: 14px;
}

.chip.liked {
    border-width: 2px;
    border-color: rgb(150, 230, 170);
}

.chip.disliked {
    opacity: 0.6;
}

.person {
    -unity-text-align: middle-left;
    margin-right: 0;
}

.hint {
    color: rgb(170, 164, 184);
    white-space: normal;
    margin: 4px 0;
}

.card {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.card-name {
    font-size: 22px;
    -unity-font-style: bold;
}

.card-sub {
    color: rgb(200, 194, 214);
    margin-bottom: 4px;
}

.stage {
    align-self: flex-start;
    padding: 2px 10px;
    margin: 4px 0 10px 0;
    border-radius: 10px;
    background-color: rgb(80, 52, 70);
    color: rgb(255, 196, 214);
    -unity-font-style: bold;
}

.meter {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.meter-label {
    width: 96px;
    font-size: 14px;
    color: rgb(200, 194, 214);
}

.meter-bar {
    flex-grow: 1;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(44, 41, 58);
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    border-radius: 5px;
}

.meter-fill.affection { background-color: rgb(236, 110, 150); }
.meter-fill.attraction { background-color: rgb(250, 160, 90); }
.meter-fill.familiarity { background-color: rgb(110, 180, 236); }
.meter-fill.trust { background-color: rgb(130, 210, 150); }

.meter-value {
    width: 34px;
    -unity-text-align: middle-right;
    font-size: 13px;
}

.known {
    margin-top: 4px;
    white-space: normal;
}

.known.liked {
    color: rgb(150, 230, 170);
}

.known.disliked {
    color: rgb(255, 160, 160);
}

.actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.choices {
    margin-top: 6px;
}

.date-progress {
    margin-top: 10px;
    color: rgb(255, 196, 214);
    white-space: normal;
    -unity-font-style: bold;
}

.contact {
    margin-bottom: 6px;
}

.contact-hint {
    margin: 0 0 0 10px;
    font-size: 13px;
}

.menu {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 120px;
}

.menu-panel {
    width: 520px;
    padding: 32px 36px;
    background-color: rgba(24, 22, 32, 0.9);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.menu-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 196, 214);
    white-space: normal;
}

.menu-subtitle {
    font-size: 16px;
    color: rgb(170, 164, 184);
    margin-bottom: 26px;
    white-space: normal;
}

.menu-button {
    font-size: 22px;
    padding: 12px 18px;
    margin: 6px 0;
}

.hint-bar {
    align-self: flex-start;
    margin-top: 8px;
    padding: 5px 12px;
    border-radius: 8px;
    background-color: rgba(24, 22, 32, 0.7);
    color: rgb(200, 194, 230);
    font-size: 14px;
    -unity-font-style: italic;
    white-space: normal;
    max-width: 760px;
}

.stats {
    font-size: 13px;
    color: rgb(170, 214, 255);
    margin: 0 0 6px 2px;
}

.bubble-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bubble {
    position: absolute;
    translate: -50% -100%;
    max-width: 280px;
    padding: 6px 12px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.93);
    color: rgb(40, 34, 52);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.chat-replies {
    flex-direction: column;
    margin-top: 8px;
}

.chat-prompt {
    font-size: 13px;
    color: rgb(190, 190, 205);
    margin-bottom: 2px;
}

.chat-reply {
    white-space: normal;
    -unity-text-align: middle-left;
    margin-left: 0;
    margin-right: 0;
    padding-top: 5px;
    padding-bottom: 5px;
}
